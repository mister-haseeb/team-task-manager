PORT=5000
NODE_ENV=development
# Long random string used to sign the session cookie
SESSION_SECRET=change-me
# Where sessions are stored: "postgres" or "memory" (defaults to postgres in production, memory otherwise)
SESSION_STORE=postgres
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/team_task_manager
