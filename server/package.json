{
  "name": "team-task-manager-server",
  "version": "1.0.0",
  "description": "Express API for the Team Task Manager",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "memorystore": "^1.6.8",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "xss": "^1.0.16"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/setup/globalSetup.js",
    "setupFiles": [
      "./tests/setup/env.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup/afterEnv.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
